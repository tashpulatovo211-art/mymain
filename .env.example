# Copy this file to .env and fill it in. Lines starting with # are ignored.

# Token from @BotFather in Telegram.
TELEGRAM_BOT_TOKEN=

# Your Telegram user ID. Leave it empty at first: message the bot and it
# replies with your ID. Only these IDs can use the bot (comma-separated).
ALLOWED_USER_IDS=

# Model to start with: claude, gpt, gemini or grok.
DEFAULT_MODEL=claude

# ---- Subscriptions -------------------------------------------------------
# Used automatically when the CLI is installed and signed in. Nothing to fill
# in here unless you want a specific model; empty means the CLI's default.
# CLAUDE_MODEL=opus
# CODEX_MODEL=
# GEMINI_MODEL=

# ---- API keys (pay per use) ---------------------------------------------
# Grok has no subscription route: SuperGrok doesn't include API access.
# Get a key at console.x.ai.
XAI_API_KEY=
# XAI_MODEL=grok-4.6

# Only used when the matching CLI isn't installed (or *_SOURCE=api below).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5
# GEMINI_API_KEY=
# GEMINI_API_MODEL=gemini-3.5-flash

# Where each model comes from: auto (CLI first, then API key), cli, or api.
# CLAUDE_SOURCE=auto
# GPT_SOURCE=auto
# GEMINI_SOURCE=auto

# ---- Other ---------------------------------------------------------------
# Folder agent mode works in.
# WORKSPACE_DIR=~/multibot-workspace
# Seconds to wait for an answer before giving up.
# REPLY_TIMEOUT=300
# How much past conversation to send with each message, in characters.
# MAX_HISTORY_CHARS=30000
